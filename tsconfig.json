{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ES2022",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "vue3-highlight-text-color": ["src/index.ts"]
    },
    "allowJs": true
  },
  "include": ["src/**/*.ts", "src/*.d.ts", "src/**/*.vue", "vite.prod.config.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
