{
  "name": "vue3-highlight-text-color",
  "version": "0.0.1",
  "description": "Hightlight text and save range",
  "keywords": [
    "vue3",
    "text",
    "hightlight",
    "marker",
    "vue",
    "vuejs",
    "save-hightlight"
  ],
  "homepage": "https://github.com/alivadjid/text-marker-range",
  "bugs": "https://github.com/alivadjid/text-marker-range/issues",
  "license": "MIT",
   "author": {
    "name": "alivadjid",
    "url": "https://github.com/alivadjid"
  },
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/user"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/text-key-lib.js",
      "require": "./dist/text-key-lib.umd.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alivadjid/text-marker-range.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm types && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "types": "vue-tsc --noEmit",
    "types:playground": "vue-tsc --noEmit -p tsconfig.playground.json"
  },
  "peerDependencies": {
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "4.2.3",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "^14.12.3",
    "sass": "^1.81.0",
    "typescript": "5.1.6",
    "vite": "4.4.8",
    "vite-plugin-dts": "^3.5.0",
    "vitest": "0.34.6",
    "vue": "3.3.4",
    "vue-tsc": "1.8.8"
  },
  "private": false,
  "type": "module",
  "packageManager": "pnpm@11.26.0"
}
