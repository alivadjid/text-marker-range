{
  "name": "vue3-highlight-text-color",
  "version": "0.0.1",
  "description": "Hightlight text and save range",
  "keywords": [
    "vue3",
    "text",
    "hightlight",
    "marker",
    "vue",
    "vuejs",
    "save-hightlight"
  ],
  "homepage": "https://github.com/alivadjid/text-marker-range",
  "bugs": "https://github.com/alivadjid/text-marker-range/issues",
  "license": "MIT",
   "author": {
    "name": "alivadjid",
    "url": "https://github.com/alivadjid"
  },
  "funding": {
    "type": "patreon",
    "url": "https://www.patreon.com/user"
  },
   "files": [
    "dist/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/text-key-lib.js",
      "require": "./dist/text-key-lib.umd.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "main": "dist/text-key-lib.js",
  "directories": {
    "lib": "dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alivadjid/text-marker-range.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "types": "vue-tsc --noEmit"
  },
  "config": {
    "port": 8080
  },
  "dependencies": {
    "vite-plugin-dts": "^3.5.0",
    "vue": "3.3.4"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-sucrase": "^5.0.1",
    "@vitejs/plugin-vue": "4.2.3",
    "sass": "^1.81.0",
    "typescript": "5.1.6",
    "vite": "4.4.8",
    "vue-tsc": "1.8.8"
  },
  "private": false,
  "type": "module",
  "module": "dist/text-key-lib.umd.cjs",
  "types": "dist/index.d.ts"
}
