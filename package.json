{
  "name": "vue3-highlight-text-color",
  "version": "1.0.0",
  "description": "Vue 3 component for creating and restoring persistent text highlights.",
  "keywords": [
    "vue",
    "vue3",
    "text-highlighter",
    "text-highlight",
    "text-selection",
    "annotations",
    "persistent-highlights"
  ],
  "homepage": "https://github.com/alivadjid/text-marker-range",
  "bugs": "https://github.com/alivadjid/text-marker-range/issues",
  "license": "MIT",
  "author": {
    "name": "alivadjid",
    "url": "https://github.com/alivadjid"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.css"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue3-highlight-text-color.js",
      "require": "./dist/vue3-highlight-text-color.umd.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alivadjid/text-marker-range.git"
  },
  "scripts": {
    "dev": "vite --mode playground",
    "build": "pnpm types && vite build",
    "build:playground": "vite build --mode playground",
    "preview": "vite preview --mode playground",
    "test": "vitest run",
    "types": "vue-tsc --noEmit",
    "types:playground": "vue-tsc --noEmit -p tsconfig.playground.json",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "check": "pnpm types && pnpm types:playground && pnpm test && pnpm build",
    "pack:check": "pnpm pack --dry-run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check",
    "release": "pnpm check && changeset publish"
  },
  "peerDependencies": {
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-vue": "4.2.3",
    "@vue/test-utils": "2.4.6",
    "happy-dom": "^14.12.3",
    "sass": "^1.81.0",
    "typescript": "5.1.6",
    "vite": "4.4.8",
    "vite-plugin-dts": "^3.5.0",
    "vitest": "0.34.6",
    "vue": "3.3.4",
    "vue-tsc": "1.8.8"
  },
  "private": false,
  "type": "module",
  "packageManager": "pnpm@11.26.0"
}
